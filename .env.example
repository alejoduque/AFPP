# BioMap Environment Variables Example
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control

# Collector mode password (for production)
VITE_COLLECTOR_PASSWORD=your-secure-password-here

# AFPP global map — the self-hosted API in server/afpp/ (no trailing slash).
# Unset → sharing and the global map are hidden; the app stays fully offline.
VITE_AFPP_API=https://altred.xyz/AlpineFeministPunkParade/afpp
# Optional: your own raster tile server for the local map (default: OpenStreetMap).
# VITE_AFPP_TILES=https://tiles.example.org/{z}/{x}/{y}.png
# Optional: the room relay for the chat's live typing, voices and live walks
# (server/afpp/deploy/realtime-on-server.sh). Locally: /afpp/_rooms (vite proxies it to :8001).
# VITE_AFPP_ROOMS=wss://altred.xyz/AlpineFeministPunkParade/afpp/_rooms
