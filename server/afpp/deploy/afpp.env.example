# /etc/afpp/afpp.env — created on the server, never committed.
# 32+ random chars: openssl rand -hex 32. Changing it invalidates every device key.
SERVER_SECRET=
# Bearer token for moderation (DELETE any derive): openssl rand -hex 24
ADMIN_TOKEN=
# Who may call the API from a browser: the site, and the app's WebView (Capacitor).
# Add http://localhost:5173 for local development against this server.
ALLOWED_ORIGINS=https://altred.xyz,https://localhost,capacitor://localhost
MAX_AUDIO_BYTES=26214400
# The chat's voice/video across networks (coturn, use-auth-secret = this secret).
# Unset → /api/ice is empty (TURN_HOST alone → STUN only) and calls connect only inside one network.
# TURN_HOST=altred.xyz:3478
# TURN_SECRET=
